{
  "name": "sound_meter",
  "version": "1.6.2",
  "description": "A floating orb for your Mac that shows when you are getting loud.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benjscohen/sound_meter.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "npm run build:helper && electron-builder",
    "test": "jest",
    "smoke": "electron -r ./scripts/smoke.js .",
    "assets": "node scripts/make-tray-icon.js && electron scripts/render-assets.js",
    "build:helper": "sh scripts/build-helper.sh",
    "check:site": "node scripts/check-site.mjs",
    "dmg:layout": "node scripts/record-dmg-layout.js",
    "readme:images": "electron scripts/render-readme.js"
  },
  "build": {
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    },
    "appId": "com.benjscohen.soundmeter",
    "productName": "Sound Meter",
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "sound_meter.icns",
      "identity": "PRM Solutions, Inc",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "This app needs access to the microphone to measure sound levels. No audio is recorded or transmitted.",
        "LSUIElement": false,
        "NSCalendarsFullAccessUsageDescription": "Sound Meter reads your calendar to show how loud you were in each meeting. Event details stay on this Mac.",
        "NSCalendarsUsageDescription": "Sound Meter reads your calendar to show how loud you were in each meeting. Event details stay on this Mac.",
        "NSAudioCaptureUsageDescription": "Sound Meter listens to what your Mac is playing only to subtract it from the microphone level, so your speakers do not count as you. Nothing is recorded."
      },
      "category": "public.app-category.productivity",
      "artifactName": "Sound-Meter-${version}-${arch}.${ext}"
    },
    "afterSign": "scripts/notarize.js",
    "afterAllArtifactBuild": "scripts/dmg.js",
    "files": [
      "main.js",
      "src/**/*",
      "assets/trayTemplate*.png",
      "package.json",
      "!src/**/*.test.js"
    ],
    "extraResources": [
      {
        "from": "native/bin/sm-helper",
        "to": "sm-helper"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    }
  },
  "keywords": [],
  "author": "Benj Cohen",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "dotenv": "^17.2.3",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "electron-log": "^5.1.0",
    "electron-updater": "^6.1.8"
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "testEnvironment": "node",
    "watchman": false
  }
}
